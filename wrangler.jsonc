{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fieryledlamp-web-flasher",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin/stats",
      "/admin/stats/",
      "/track/*",
      "/firmware/update.zip"
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "STATS",
      "dataset": "fieryledlamp_web_stats"
    }
  ]
}
